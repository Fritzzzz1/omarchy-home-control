#!/bin/bash
# home-control-ctl — the one place that knows how Home Control is wired on this machine.
#
# status --json exists so other tools can shell out to this instead of re-deriving how the
# service is wired themselves.

set -uo pipefail

CONFIG_FILE="${HOME_CONTROL_CONFIG:-$HOME/.config/home-control/config.env}"
UNIT="${HOME_CONTROL_UNIT:-home-control.service}"
# The Home Server's TTS: a common service Home Control calls, reported here, never started or stopped here.
TTS_UNIT="${HOME_CONTROL_TTS_UNIT:-tts.service}"

# The service format is deliberately plain KEY=VALUE rather than shell code:
# owner names and project paths commonly contain spaces, and a diagnostic command
# must never execute a value somebody pasted into the config file.
load_config() {
  [[ -f $CONFIG_FILE ]] || return 0
  local line key value
  while IFS= read -r line || [[ -n $line ]]; do
    [[ -z $line || $line == \#* ]] && continue
    [[ $line =~ ^([A-Z_][A-Z0-9_]*)=(.*)$ ]] || continue
    key="${BASH_REMATCH[1]}"; value="${BASH_REMATCH[2]}"
    case "$key" in
      PATH|VOICE_ROOT|VOICE_LABEL|VOICE_STATE|VOICE_TOKEN|VOICE_PORT|VOICE_HOST|TTS_PORT|WHISPER_URL|WHISPER_MODEL|VOICE_LOCAL_PLAYER|VOICE_OWNER|VOICE_EDGE_TTS|VOICE_SPEECH_REWRITE|VOICE_LANG|VOICE_PEER_DELEGATION|VOICE_MODEL|VOICE_EFFORT|VOICE_REWRITE_MODEL|VOICE_VOICE_EN|VOICE_VOICE_HE|VOICE_PERMISSION_MODE|VOICE_ON_INPUT|VOICE_AWAY|HOME_CONTROL_TAILNET_HOST|HOME_CONTROL_APP_DIR)
        printf -v "$key" '%s' "$value"; export "$key" ;;
    esac
  done < "$CONFIG_FILE"
}
load_config

VOICE_PORT="${VOICE_PORT:-4455}"
TTS_PORT="${TTS_PORT:-4457}"
HOME_CONTROL_TAILNET_HOST="${HOME_CONTROL_TAILNET_HOST:-}"

# Home Control Mobile (the phone page): /mobile/ on the server, /home-control/mobile/ behind the Home Server gateway.
url() {
  if [[ -n $HOME_CONTROL_TAILNET_HOST ]]; then
    echo "https://$HOME_CONTROL_TAILNET_HOST/home-control/mobile/"
  else
    echo "http://127.0.0.1:$VOICE_PORT/mobile/"
  fi
}
# Home Control (the dashboard), on this machine, through the gateway.
dashboard_url() { echo "http://127.0.0.1:4400/home-control/"; }

# `is-active` exits non-zero for anything but "active"; we want the word, not the code.
state() { systemctl --user is-active "$UNIT" 2>/dev/null || true; }
tts_state() { systemctl --user is-active "$TTS_UNIT" 2>/dev/null || true; }

# Any HTTP status means the server answered. The login gate replies 302/401 to an
# unauthenticated probe, so `curl -f` would call a perfectly healthy Home Control dead.
reachable() {
  local code
  code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 2 "http://127.0.0.1:$VOICE_PORT/" 2>/dev/null)
  [[ -n $code && $code != 000 ]] && echo true || echo false
}

usage() {
  cat <<'USAGE'
Usage: home-control-ctl <command>

  status [--json]   unit state, local reachability, the phone and dashboard URLs, the TTS service
  start | stop | restart
  enable | disable  start at boot (user linger must be on)
  logs [-f]         journalctl for the unit
  url               the URL to open on the phone
  doctor            check the things Home Control depends on

Restarting kills any conversation in progress: the `claude` process talking to
the caller is a child of this service.
USAGE
}

case "${1:-status}" in
status)
  s=$(state)
  t=$(tts_state)
  if [[ ${2:-} == --json ]]; then
    jq -nc --arg state "${s:-unknown}" --arg url "$(url)" \
      --argjson reachable "$(reachable)" --arg unit "$UNIT" --arg dashboard_url "$(dashboard_url)" \
      --arg tts_unit "$TTS_UNIT" --arg tts_state "${t:-unknown}" --arg tts_port "$TTS_PORT" \
      '{unit:$unit, state:$state, reachable:$reachable, url:$url, dashboard_url:$dashboard_url,
        tts:{unit:$tts_unit, state:$tts_state, port:($tts_port|tonumber), common:true}}'
  else
    printf 'unit       %s\nstate      %s\nreachable  %s\nmobile     %s\ndashboard  %s\n' \
      "$UNIT" "${s:-unknown}" "$(reachable)" "$(url)" "$(dashboard_url)"
    printf 'tts        %s (%s)   127.0.0.1:%s   common Home Server service, not started by Home Control\n' \
      "$TTS_UNIT" "${t:-unknown}" "$TTS_PORT"
  fi
  ;;
start | stop | enable | disable)
  systemctl --user "$1" "$UNIT"
  ;;
restart)
  # Deliberately loud: this is the one destructive thing here.
  if [[ ${2:-} != --force && -t 0 ]]; then
    read -r -p "Restart $UNIT? This ends any conversation in progress. [y/N] " a
    [[ $a == [yY]* ]] || { echo "aborted"; exit 1; }
  fi
  systemctl --user restart "$UNIT"
  ;;
logs) shift; journalctl --user -u "$UNIT" "$@" ;;
url) url ;;
doctor)
  fail=0
  say() { printf '%-22s %s\n' "$1" "$2"; }
  [[ -f $CONFIG_FILE ]] && say "config" "$CONFIG_FILE" || { say "config" "MISSING $CONFIG_FILE"; fail=1; }
  for v in VOICE_ROOT VOICE_STATE; do
    [[ -n ${!v:-} ]] && say "$v" "${!v}" || { say "$v" "unset"; fail=1; }
  done
  for c in node claude curl; do
    p=$(command -v "$c") && say "$c" "$p" || { say "$c" "NOT FOUND"; fail=1; }
  done
  t=$(tts_state)
  curl -fsS -o /dev/null --max-time 2 "http://127.0.0.1:$TTS_PORT/health" 2>/dev/null \
    && say "tts" "$TTS_UNIT ${t:-unknown}, answering on $TTS_PORT" \
    || say "tts" "$TTS_UNIT ${t:-unknown}, NOT answering on $TTS_PORT (speech falls back to the edge-tts CLI)"
  if [[ -n ${WHISPER_URL:-} ]]; then
    curl -fsS -o /dev/null --max-time 4 "$WHISPER_URL" 2>/dev/null \
      && say "whisper" "reachable" || say "whisper" "NOT reachable (asleep?)"
  elif [[ -n ${WHISPER_MODEL:-} ]]; then
    [[ -f $WHISPER_MODEL ]] && say "whisper model" "$WHISPER_MODEL" || { say "whisper model" "MISSING $WHISPER_MODEL"; fail=1; }
    command -v whisper-server >/dev/null && say "whisper-server" "$(command -v whisper-server)" \
      || { say "whisper-server" "NOT FOUND"; fail=1; }
  else
    say "whisper" "unset (set WHISPER_URL or WHISPER_MODEL)"; fail=1
  fi
  command -v tailscale >/dev/null && say "tailscale" "$(tailscale status --json 2>/dev/null | jq -r '.BackendState // "unknown"')" \
    || say "tailscale" "not installed"
  s=$(state); say "unit" "${s:-unknown}"
  exit $fail
  ;;
-h | --help | help) usage ;;
*) usage >&2; exit 1 ;;
esac
