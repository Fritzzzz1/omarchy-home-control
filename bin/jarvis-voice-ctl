#!/bin/bash
# jarvis-voice-ctl — the one place that knows how Jarvis is wired on this machine.
#
# Both the bar widget and a human use this, so the QML stays dumb: it shells out
# to `jarvis-voice-ctl status --json` and renders whatever comes back.

set -uo pipefail

CONFIG_FILE="${JARVIS_CONFIG:-$HOME/.config/jarvis-voice/config.env}"
UNIT="${JARVIS_UNIT:-jarvis-voice.service}"

# shellcheck disable=SC1090
[[ -f $CONFIG_FILE ]] && set -a && . "$CONFIG_FILE" && set +a

VOICE_PORT="${VOICE_PORT:-4455}"
JARVIS_TAILNET_HOST="${JARVIS_TAILNET_HOST:-}"
JARVIS_TAILNET_PORT="${JARVIS_TAILNET_PORT:-8443}"

url() {
  if [[ -n $JARVIS_TAILNET_HOST ]]; then
    echo "https://$JARVIS_TAILNET_HOST:$JARVIS_TAILNET_PORT"
  else
    echo "http://127.0.0.1:$VOICE_PORT"
  fi
}

# `is-active` exits non-zero for anything but "active"; we want the word, not the code.
state() { systemctl --user is-active "$UNIT" 2>/dev/null || true; }

# Any HTTP status means the server answered. The login gate replies 302/401 to an
# unauthenticated probe, so `curl -f` would call a perfectly healthy Jarvis dead.
reachable() {
  local code
  code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 2 "http://127.0.0.1:$VOICE_PORT/" 2>/dev/null)
  [[ -n $code && $code != 000 ]] && echo true || echo false
}

usage() {
  cat <<'USAGE'
Usage: jarvis-voice-ctl <command>

  status [--json]   unit state, local reachability, and the phone URL
  start | stop | restart
  enable | disable  start at boot (user linger must be on)
  logs [-f]         journalctl for the unit
  url               the URL to open on the phone
  doctor            check the things Jarvis depends on

Restarting kills any conversation in progress: the `claude` process talking to
the caller is a child of this service.
USAGE
}

case "${1:-status}" in
status)
  s=$(state)
  if [[ ${2:-} == --json ]]; then
    jq -nc --arg state "${s:-unknown}" --arg url "$(url)" \
      --argjson reachable "$(reachable)" --arg unit "$UNIT" \
      '{unit:$unit, state:$state, reachable:$reachable, url:$url}'
  else
    printf 'unit       %s\nstate      %s\nreachable  %s\nurl        %s\n' \
      "$UNIT" "${s:-unknown}" "$(reachable)" "$(url)"
  fi
  ;;
start | stop | enable | disable) systemctl --user "$1" "$UNIT" ;;
restart)
  # Deliberately loud: this is the one destructive thing here.
  if [[ ${2:-} != --force && -t 0 ]]; then
    read -r -p "Restart $UNIT? This ends any conversation in progress. [y/N] " a
    [[ $a == [yY]* ]] || { echo "aborted"; exit 1; }
  fi
  systemctl --user restart "$UNIT"
  ;;
logs) shift; journalctl --user -u "$UNIT" "$@" ;;
url) url ;;
doctor)
  fail=0
  say() { printf '%-22s %s\n' "$1" "$2"; }
  [[ -f $CONFIG_FILE ]] && say "config" "$CONFIG_FILE" || { say "config" "MISSING $CONFIG_FILE"; fail=1; }
  for v in VOICE_ROOT VOICE_STATE WHISPER_URL; do
    [[ -n ${!v:-} ]] && say "$v" "${!v}" || { say "$v" "unset"; fail=1; }
  done
  for c in node claude curl; do
    p=$(command -v "$c") && say "$c" "$p" || { say "$c" "NOT FOUND"; fail=1; }
  done
  if [[ -n ${JARVIS_TTS_PYTHON:-} && -x ${JARVIS_TTS_PYTHON:-} ]]; then
    say "tts python" "$JARVIS_TTS_PYTHON"
    "$JARVIS_TTS_PYTHON" -c 'import edge_tts' 2>/dev/null \
      && say "edge-tts" "importable" || { say "edge-tts" "NOT IMPORTABLE"; fail=1; }
  else
    say "tts python" "MISSING (JARVIS_TTS_PYTHON)"; fail=1
  fi
  if [[ -n ${WHISPER_URL:-} ]]; then
    curl -fsS -o /dev/null --max-time 4 "$WHISPER_URL" 2>/dev/null \
      && say "whisper" "reachable" || say "whisper" "NOT reachable (asleep?)"
  fi
  command -v tailscale >/dev/null && say "tailscale" "$(tailscale status --json 2>/dev/null | jq -r '.BackendState // "unknown"')" \
    || say "tailscale" "not installed"
  s=$(state); say "unit" "${s:-unknown}"
  exit $fail
  ;;
-h | --help | help) usage ;;
*) usage >&2; exit 1 ;;
esac
