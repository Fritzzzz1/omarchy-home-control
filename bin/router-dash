#!/usr/bin/env node
// Live dashboard for the Jev router log. Read-only, single file, no deps.
// Serves HTML + /api/turns on 127.0.0.1:4492, reading router.jsonl fresh each request.
import fs from 'node:fs';
import path from 'node:path';
import os from 'node:os';
import http from 'node:http';

const LABEL = process.env.VOICE_LABEL || 'home';
const STATE = process.env.VOICE_STATE || path.join(os.homedir(), '.local', 'share', 'home-control', 'state', LABEL);
const ROUTER_FILE = path.join(STATE, 'router.jsonl');
// Every Jev consumer on this machine writes the shared trace line; this page shows them all.
// name -> file. Add a consumer here (or JEV_TRACES="name=path,name=path").
const TRACES = { router: ROUTER_FILE,
  tailgather: path.join(os.homedir(), '.local', 'share', 'tailgather', 'jev.jsonl') };
for (const kv of (process.env.JEV_TRACES || '').split(',').filter(Boolean)) {
  const [k, v] = kv.split('='); if (k && v) TRACES[k.trim()] = v.trim();
}
const PORT = 4492;
const HOST = '127.0.0.1';

function readTurns() {
  const out = [];
  for (const [source, file] of Object.entries(TRACES)) {
    if (!fs.existsSync(file)) continue;
    for (const line of fs.readFileSync(file, 'utf8').split('\n')) {
      if (!line.trim()) continue;
      try { const t = JSON.parse(line); t.source = t.source || source; out.push(t); }
      catch { /* skip malformed/half-written last line */ }
    }
  }
  // Oldest first, like a single file would be; the API reverses it.
  out.sort((a, b) => (Date.parse(a.at) || 0) - (Date.parse(b.at) || 0));
  return out;
}

const pct = (xs, p) => {
  if (!xs.length) return null;
  const s = xs.slice().sort((a, b) => a - b);
  return s[Math.min(s.length - 1, Math.floor(p * s.length))];
};

function buildSummary(rows) {
  const jevMs = rows.map((t) => t.jev?.ms).filter((x) => x != null);
  const jevErrors = rows.filter((t) => t.jev?.error).length;
  const jevOk = rows.filter((t) => t.jev && !t.jev.error).length;
  const routed = rows.filter((t) => t.routed).length;
  const dropped = rows.filter((t) => t.routed === 'dropped').length;
  const byJev = rows.filter((t) => t.result?.by === 'router').length;
  const byClaude = rows.filter((t) => t.result?.by === 'claude').length;
  const modes = {};
  for (const t of rows) { const m = t.mode || '-'; modes[m] = (modes[m] || 0) + 1; }
  const sources = {};
  for (const t of rows) { sources[t.source || 'router'] = (sources[t.source || 'router'] || 0) + 1; }
  return {
    sources,
    turns: rows.length,
    jev_ok: jevOk,
    jev_errors: jevErrors,
    routed,
    dropped,
    by_jev: byJev,
    by_claude: byClaude,
    p50: pct(jevMs, 0.5),
    p95: pct(jevMs, 0.95),
    modes,
    // The effective config of the most recent turn: what the router is running on right now.
    config: rows.find((t) => t.config)?.config || null,
  };
}

// Lines that share an ask_id become one row: the first line, with every line under `parts`.
function foldAsks(rows) {
  const out = []; const byAsk = new Map();
  for (const t of rows) {
    if (!t.ask_id) { out.push(t); continue; }
    const head = byAsk.get(t.ask_id);
    if (head) head.parts.push(t);
    else { const h = { ...t, parts: [t] }; byAsk.set(t.ask_id, h); out.push(h); }
  }
  return out;
}

const server = http.createServer((req, res) => {
  const url = req.url.split('?')[0];
  if (url === '/api/turns') {
    let rows;
    try { rows = readTurns(); } catch (e) { res.writeHead(500); res.end(String(e)); return; }
    rows = foldAsks(rows).slice(-300).reverse(); // newest first
    const body = JSON.stringify({ summary: buildSummary(rows), turns: rows });
    res.writeHead(200, { 'Content-Type': 'application/json' });
    res.end(body);
    return;
  }
  if (url === '/' || url === '/index.html') {
    res.writeHead(200, { 'Content-Type': 'text/html; charset=utf-8' });
    res.end(PAGE);
    return;
  }
  res.writeHead(404);
  res.end('not found');
});

server.listen(PORT, HOST, () => {
  console.log(`router-dash listening on http://${HOST}:${PORT}  (reading ${Object.values(TRACES).join(', ')})`);
});

const PAGE = `<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Jev Router Dashboard</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
  :root {
    --bg: #0e1117; --panel: #161b22; --panel2: #1c2230; --border: #2a3040;
